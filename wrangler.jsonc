{
  // Configuración para publicar northik.ai en Cloudflare (Workers con archivos estáticos).
  "name": "northik-web",
  "compatibility_date": "2026-10-01",
  "main": "worker/index.js",
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    // Solo /api/* pasa por el programa; el resto de la web se sirve directo.
    "run_worker_first": ["/api/*", "/admin/*"]
  },
  // Base de datos donde se guardan los mensajes del formulario.
  "d1_databases": [
    { "binding": "DB", "database_name": "northik-formularios", "database_id": "cd77a76f-5efa-4b64-a121-cae6fd0b8da7" }
  ],
  // Pantallazos de estadísticas de los creadores (/creadores/). Bucket privado: no tiene acceso público.
  // Crearlo una sola vez antes de publicar: npx wrangler r2 bucket create northik-creadores
  "r2_buckets": [
    { "binding": "ARCHIVOS_CREADORES", "bucket_name": "northik-creadores" }
  ],
  // Límite de envíos del formulario: 5 por minuto por dirección.
  "ratelimits": [
    { "name": "LIMITE_FORMULARIO", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } }
  ],
  // Aviso por correo de cada mensaje nuevo. El destino es el secreto AVISO_PARA
  // (npx wrangler secret put AVISO_PARA) y debe estar verificado en Email Routing.
  "send_email": [
    { "name": "EMAIL" }
  ],
  "vars": {
    "AVISO_DE": "formulario@northik.ai",
    // Se llenan al configurar Cloudflare Access para las descargas en CSV.
    "ACCESS_TEAM_DOMAIN": "old-river-e3fc.cloudflareaccess.com",
    "ACCESS_AUD": "c86d591dc709855c32456a76ccff14633c27b53b9c29b9d2ff972f5e594ce32a",
    // Agenda: ID del cliente OAuth de Google (no es secreto). El client secret y el refresh token
    // van como secretos: npx wrangler secret put GOOGLE_CLIENT_SECRET / GOOGLE_REFRESH_TOKEN
    "GOOGLE_CLIENT_ID": "990715747261-cb80ahirg2o98pfftsr7a2a8psofsn31.apps.googleusercontent.com",
    // Agenda: ID de la hoja privada «Northik · Agenda» (lo llena scripts/token-google.mjs al crearla).
    "AGENDA_SHEET_ID": "17FFgW7dc5fM5EHuaH-1gu-PHtSQ8JNpWcOPIKZ7gn2M",
    // Creadores: ID de la hoja privada «Northik · Creadores». Si queda vacío, la web la crea sola con el primer
    // registro (en el Drive de northik.admin) y guarda su ID en D1 (tabla ajustes).
    "CREADORES_SHEET_ID": ""
  },
  // Borrado mensual de interesados con más de 24 meses sin escribir, de citas de /agenda y de registros de /creadores con más de 24 meses: día 1 a las 3:00 a. m. de Colombia.
  "triggers": { "crons": ["0 8 1 * *"] },
  "observability": { "enabled": true }
}
