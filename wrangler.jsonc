{
  // Configuración para publicar northik.ai en Cloudflare (Workers con archivos estáticos).
  "name": "northik-web",
  "compatibility_date": "2026-10-01",
  "main": "worker/index.js",
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    // Solo /api/* pasa por el programa; el resto de la web se sirve directo.
    "run_worker_first": ["/api/*", "/admin/*"]
  },
  // Base de datos donde se guardan los mensajes del formulario.
  "d1_databases": [
    { "binding": "DB", "database_name": "northik-formularios", "database_id": "cd77a76f-5efa-4b64-a121-cae6fd0b8da7" }
  ],
  // Límite de envíos del formulario: 5 por minuto por dirección.
  "ratelimits": [
    { "name": "LIMITE_FORMULARIO", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } }
  ],
  // Aviso por correo de cada mensaje nuevo (el destino debe estar verificado en Email Routing).
  "send_email": [
    { "name": "EMAIL", "destination_address": "northik.admin@gmail.com" }
  ],
  "vars": {
    "AVISO_PARA": "northik.admin@gmail.com",
    "AVISO_DE": "formulario@northik.ai",
    // Se llenan al configurar Cloudflare Access para las descargas en CSV.
    "ACCESS_TEAM_DOMAIN": "old-river-e3fc.cloudflareaccess.com",
    "ACCESS_AUD": "c86d591dc709855c32456a76ccff14633c27b53b9c29b9d2ff972f5e594ce32a"
  },
  // Borrado mensual de interesados con más de 24 meses sin escribir: día 1 a las 3:00 a. m. de Colombia.
  "triggers": { "crons": ["0 8 1 * *"] },
  "observability": { "enabled": true }
}
